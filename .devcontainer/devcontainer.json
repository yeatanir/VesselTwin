{
  "name": "VesselTwin",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [8501],
  "portsAttributes": {"8501": {"label": "VesselTwin dashboard", "onAutoForward": "openBrowser"}},
  "postAttachCommand": "streamlit run app/dashboard.py --server.address=0.0.0.0 --server.port=8501 --browser.gatherUsageStats=false",
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}}
}
